import java.util.Scanner;

public class licencia {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Entradas
        System.out.print("¿Tiene licencia? (true/false): ");
        boolean tieneLicencia = sc.nextBoolean();

        System.out.print("¿La licencia está vigente? (true/false): ");
        boolean estaVigente = sc.nextBoolean();

        System.out.print("¿Cumple la categoría requerida? (true/false): ");
        boolean cumpleCategoria = sc.nextBoolean();

        // Lógica equivalente al pseudocódigo
        if (!tieneLicencia) {
            System.out.println("No puede aplicar");
        } else if (!estaVigente) {
            System.out.println("No puede aplicar");
        } else if (!cumpleCategoria) {
            System.out.println("No puede aplicar");
        } else {
            System.out.println("Puede aplicar a la vacante");
        }
    }
}
